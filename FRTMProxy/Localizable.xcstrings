    "Export the collection as `.har`, create a commit, and push to a branch. Optionally create a tag too.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta la collection come `.har`, crea un commit ed esegui il push su un branch. Facoltativamente crea anche un tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta la colección como `.har`, crea un commit y haz push a una rama. Opcionalmente, crea también un tag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez la collection au format `.har`, créez un commit et poussez vers une branche. Vous pouvez également créer un tag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammlung als `.har` exportieren, einen Commit erstellen und in einen Branch pushen. Optional auch einen Tag erstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte a coleção como `.har`, crie um commit e faça push para um branch. Opcionalmente, crie também uma tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションを `.har` としてエクスポートし、コミットを作成してブランチにプッシュします。必要に応じてタグも作成できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将集合导出为 `.har`，创建提交并推送到分支。也可选择创建标签。"
          }
        }
      }
    },
