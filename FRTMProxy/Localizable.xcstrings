    "When enabled, macOS routes HTTP and HTTPS traffic to localhost on the selected port." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, leitet macOS HTTP- und HTTPS-Traffic an localhost auf dem ausgewählten Port weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, macOS enruta el tráfico HTTP y HTTPS a localhost en el puerto seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, macOS achemine le trafic HTTP et HTTPS vers localhost sur le port sélectionné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando abilitato, macOS instrada il traffico HTTP e HTTPS verso localhost sulla porta selezionata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、macOS は HTTP および HTTPS トラフィックを選択したポートの localhost に転送します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o macOS roteia o tráfego HTTP e HTTPS para o localhost na porta selecionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，macOS 会将 HTTP 和 HTTPS 流量路由到所选端口上的 localhost。"
          }
        }
      }
    },
    "When enabled, mitmproxy only MITMs active pinned hosts; all other HTTPS traffic is tunneled. Restart the proxy to apply changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, führt mitmproxy nur bei aktiven angehefteten Hosts einen MITM durch; der gesamte übrige HTTPS-Traffic wird getunnelt. Proxy neu starten, um Änderungen zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, mitmproxy solo aplica MITM a los hosts fijados activos; el resto del tráfico HTTPS se tuneliza. Reinicia el proxy para aplicar los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, mitmproxy n'effectue le MITM que sur les hosts épinglés actifs ; tout le reste du trafic HTTPS est tunnelé. Redémarrez le proxy pour appliquer les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando abilitato, mitmproxy applica il MITM solo agli host fissati attivi; tutto il resto del traffico HTTPS viene incanalato in un tunnel. Riavvia il proxy per applicare le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、mitmproxy はアクティブなピン留めホストのみを MITM し、その他すべての HTTPS トラフィックはトンネリングされます。変更を適用するにはプロキシを再起動してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o mitmproxy faz MITM apenas nos hosts fixados ativos; todo o restante do tráfego HTTPS é tunelado. Reinicie o proxy para aplicar as alterações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，mitmproxy 仅对活动的固定主机进行 MITM；所有其他 HTTPS 流量将被隧道转发。重启代理以应用更改。"
          }
        }
      }
    },
    "Wifi + IP info used by device pairing and map-local tooling." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi‑Fi- und IP-Informationen, die von der Gerätekopplung und den Map-Local-Tools verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Información de Wi‑Fi e IP utilizada por el emparejamiento de dispositivos y las herramientas de Map Local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informations Wi‑Fi + IP utilisées par l'appairage d'appareils et les outils Map Local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informazioni Wi‑Fi + IP usate dall'abbinamento dei dispositivi e dagli strumenti map-local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスのペアリングと Map Local ツールで使用される Wi-Fi + IP 情報。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informações de Wi‑Fi + IP usadas pelo pareamento de dispositivos e pelas ferramentas de Map Local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备配对和 map-local 工具使用的 Wi‑Fi + IP 信息。"
          }
        }
      }
    },
    "Wildcard support: use * or ? in host/path (e.g. *.example.com, /v1/*)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wildcard-Unterstützung: * oder ? in Host/Pfad verwenden (z. B. *.example.com, /v1/*)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible con comodines: usa * o ? en host/ruta (p. ej. *.example.com, /v1/*)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prise en charge des wildcards : utilisez * ou ? dans le host/chemin (ex. *.example.com, /v1/*)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supporto wildcard: usa * o ? in host/percorso (es. *.example.com, /v1/*)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイルドカード対応: ホスト/パスで * または ? を使用できます (例: *.example.com、/v1/*)。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suporte a curinga: use * ou ? no host/caminho (ex.: *.example.com, /v1/*)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持通配符：在主机/路径中使用 * 或 ?（例如 *.example.com、/v1/*）。"
          }
        }
      }
    },
