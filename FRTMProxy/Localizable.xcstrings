    "HTTPS is intercepted only after step 3. Installing the profile without enabling trust is not enough." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS wird erst nach Schritt 3 abgefangen. Das Installieren des Profils ohne Aktivieren des Vertrauens reicht nicht aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tráfico HTTPS solo se intercepta después del paso 3. Instalar el perfil sin activar la confianza no es suficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trafic HTTPS n'est intercepté qu'après l'étape 3. Installer le profil sans activer la confiance ne suffit pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traffico HTTPS viene intercettato solo dopo il passaggio 3. Installare il profilo senza abilitare l'attendibilità non è sufficiente."
