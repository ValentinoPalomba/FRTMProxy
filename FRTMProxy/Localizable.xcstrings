          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le flux sélectionné"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählten Flow verwenden"
          }
        },
        "pt-BR": {
