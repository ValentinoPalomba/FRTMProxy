    "Profiles are tied to the current SSID. If you switch network, restart the server to regenerate the QR code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile sind an die aktuelle SSID gebunden. Bei einem Netzwerkwechsel den Server neu starten, um den QR-Code neu zu generieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles están vinculados al SSID actual. Si cambias de red, reinicia el servidor para regenerar el código QR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils sont liés au SSID actuel. Si vous changez de réseau, redémarrez le serveur pour régénérer le QR code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili sono legati all'SSID attuale. Se cambi rete, riavvia il server per rigenerare il QR code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルは現在の SSID に紐付けられています。ネットワークを切り替えた場合は、サーバーを再起動して QR コードを再生成してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis estão vinculados ao SSID atual. Se você trocar de rede, reinicie o servidor para regenerar o QR code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述文件与当前 SSID 绑定。如果切换网络，请重启服务器以重新生成 QR 码。"
          }
        }
      }
    },
