    "This permanently removes the session and its captured flows. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Sitzung und die erfassten Flows dauerhaft entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente la sesión y sus flujos capturados. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement la session et ses flux capturés. Cette action ne peut pas être annulée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò rimuove permanentemente la sessione e i relativi flussi acquisiti. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、セッションとそのキャプチャされたフローが完全に削除されます。この操作は元に戻すことができません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente a sessão e seus fluxos capturados. Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除会话及其捕获的流。此操作无法撤消。"
          }
        }
      }
    },
    "This removes every flow from the current session and cannot be undone." : {
