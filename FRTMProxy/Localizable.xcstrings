    "Import and sync collections from a Git repository (branch/tag/commit). Collections are read from `.har` files in the repo.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa e sincronizza le collection da un repository Git (branch/tag/commit). Le collection vengono lette dai file `.har` nel repo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa y sincroniza colecciones desde un repositorio Git (rama/tag/commit). Las colecciones se leen de archivos `.har` del repositorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez et synchronisez des collections depuis un dépôt Git (branche/tag/commit). Les collections sont lues à partir des fichiers `.har` du dépôt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammlungen aus einem Git-Repository importieren und synchronisieren (Branch/Tag/Commit). Sammlungen werden aus `.har`-Dateien im Repo gelesen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe e sincronize coleções de um repositório Git (branch/tag/commit). As coleções são lidas de arquivos `.har` no repositório."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git リポジトリ (ブランチ/タグ/コミット) からコレクションをインポートして同期します。コレクションはリポジトリ内の `.har` ファイルから読み込まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Git 仓库（分支/标签/提交）导入并同步集合。集合从仓库中的 `.har` 文件读取。"
          }
        }
      }
    },
    "Imported collections will remain in your workspace; sync will be disabled.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collection importate rimarranno nel tuo workspace; la sincronizzazione verrà disabilitata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las colecciones importadas permanecerán en tu espacio de trabajo; la sincronización se desactivará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les collections importées resteront dans votre espace de travail ; la synchronisation sera désactivée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Sammlungen bleiben im Workspace erhalten; die Synchronisierung wird deaktiviert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As coleções importadas permanecerão no seu workspace; a sincronização será desativada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートしたコレクションはワークスペースに残りますが、同期は無効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的集合将保留在工作区中；同步将被禁用。"
          }
        }
      }
    },
    "Includes proxy settings and the mitmproxy CA for the detected Wi‑Fi network.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include le impostazioni proxy e la CA di mitmproxy per la rete Wi‑Fi rilevata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye la configuración del proxy y la CA de mitmproxy para la red Wi‑Fi detectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut les paramètres proxy et la CA mitmproxy pour le réseau Wi‑Fi détecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Proxy-Einstellungen und die mitmproxy-CA für das erkannte Wi‑Fi-Netzwerk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui as configurações de proxy e a CA do mitmproxy para a rede Wi‑Fi detectada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出された Wi‑Fi ネットワークのプロキシ設定と mitmproxy CA を含みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含检测到的 Wi‑Fi 网络的代理设置和 mitmproxy CA。"
          }
        }
      }
    },
    "Inject latency, bandwidth caps, and packet loss on intercepted traffic.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inietta latenza, limiti di banda e perdita di pacchetti sul traffico intercettato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inyecta latencia, límites de ancho de banda y pérdida de paquetes en el tráfico interceptado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Injectez de la latence, des limites de bande passante et de la perte de paquets sur le trafic intercepté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Latenz, Bandbreitenbegrenzungen und Paketverlust in abgefangenen Traffic einschleusen."
          }
        },
        "pt-BR": {
          "stringUnit": {
