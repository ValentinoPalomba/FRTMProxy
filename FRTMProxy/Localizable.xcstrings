    "All-in-one toolkit for debugging HTTPS traffic with mitmproxy, SwiftUI and plenty of quality-of-life utilities.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolkit all-in-one per il debug del traffico HTTPS con mitmproxy, SwiftUI e numerose utility che migliorano l'esperienza d'uso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit de herramientas todo en uno para depurar tráfico HTTPS con mitmproxy, SwiftUI y multitud de utilidades que facilitan el trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boîte à outils tout-en-un pour déboguer le trafic HTTPS avec mitmproxy, SwiftUI et de nombreux utilitaires pratiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "All-in-one-Toolkit zum Debuggen von HTTPS-Traffic mit mitmproxy, SwiftUI und zahlreichen praktischen Hilfsfunktionen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit completo para depurar tráfego HTTPS com mitmproxy, SwiftUI e várias utilidades para facilitar o dia a dia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mitmproxy、SwiftUI、そして数多くの便利な機能で HTTPS トラフィックをデバッグするオールインワンツールキット。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一体化工具包，使用 mitmproxy、SwiftUI 以及大量实用的便捷工具调试 HTTPS 流量。"
          }
        }
      }
    },
