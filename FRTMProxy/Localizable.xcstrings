    "Enter one argument per line. Arguments are passed directly without a shell." : {
      "comment" : "A description below the text editor in the `SelectiveCaptureView` that explains how to use it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
