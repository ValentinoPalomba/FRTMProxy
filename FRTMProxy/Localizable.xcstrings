    "Rules execute by ascending priority. Actions within a rule execute top to bottom." : {
      "comment" : "A description below the general section of the unified traffic rule editor, explaining how the rules are ordered and how actions are executed within them.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln werden nach aufsteigender Priorität ausgeführt. Aktionen innerhalb einer Regel werden von oben nach unten ausgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas se ejecutan por prioridad ascendente. Las acciones dentro de una regla se ejecutan de arriba a abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles s'exécutent par priorité croissante. Les actions au sein d'une règle s'exécutent de haut en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole vengono eseguite con priorità crescente. Le azioni all'interno di una regola vengono eseguite dall'alto verso il basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールは優先順位に従って実行されます。ルール内のアクションは上から下に実行されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras são executadas por prioridade crescente. As ações dentro de uma regra são executadas de cima para baixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则按优先级升序执行。规则内的操作从上到下执行。"
          }
        }
      }
    },
    "Rules execute from top to bottom. Reorder them in the Traffic Rules list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln werden von oben nach unten ausgeführt. Ordnen Sie sie in der Liste der Verkehrsregeln neu an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas se ejecutan de arriba a abajo. Reordenarlos en la lista de Normas de tráfico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles s'exécutent de haut en bas. Réorganisez-les dans la liste des règles de circulation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole vengono eseguite dall'alto verso il basso. Riordinali nell'elenco Regole del traffico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールは上から下に実行されます。 [トラフィック ルール] リストでそれらを並べ替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras são executadas de cima para baixo. Reordene-os na lista Regras de trânsito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则从上到下执行。在流量规则列表中对它们重新排序。"
