    "If Wi‑Fi is blank, grant Location permission in System Settings → Privacy & Security → Location Services.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il campo Wi‑Fi è vuoto, concedi il permesso di Localizzazione in Impostazioni di Sistema → Privacy e Sicurezza → Servizi di localizzazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la Wi‑Fi aparece en blanco, concede el permiso de Localización en Ajustes del Sistema → Privacidad y seguridad → Localización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le Wi‑Fi est vide, accordez l'autorisation de localisation dans Réglages Système → Confidentialité et sécurité → Service de localisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Wi‑Fi leer ist, Standortberechtigung unter Systemeinstellungen → Datenschutz & Sicherheit → Ortungsdienste erteilen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Wi‑Fi estiver em branco, conceda a permissão de Localização em Ajustes do Sistema → Privacidade e Segurança → Serviços de Localização."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi が空欄の場合は、システム設定 → プライバシーとセキュリティ → 位置情報サービス で位置情報の許可を与えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Wi‑Fi 为空，请在“系统设置 → 隐私与安全性 → 定位服务”中授予定位权限。"
          }
        }
      }
    },
    "If set, FRTMProxy will create an annotated tag after the push.": {
      "localizations": {
        "it": {
