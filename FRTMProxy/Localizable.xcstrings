    "• ⌘K to open the command palette\n• ⌘⌥K to clear captured flows\n• Manage → Device for QR pairing": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• ⌘K per aprire la command palette\n• ⌘⌥K per cancellare i flussi catturati\n• Gestisci → Dispositivo per l'abbinamento tramite QR"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• ⌘K para abrir la paleta de comandos\n• ⌘⌥K para borrar los flujos capturados\n• Gestionar → Dispositivo para el emparejamiento por QR"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• ⌘K pour ouvrir la palette de commandes\n• ⌘⌥K pour effacer les flux capturés\n• Gérer → Appareil pour l'appairage QR"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• ⌘K zum Öffnen der Befehlspalette\n• ⌘⌥K zum Löschen erfasster Flows\n• Verwalten → Gerät für QR-Kopplung"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• ⌘K para abrir a paleta de comandos\n• ⌘⌥K para limpar os flows capturados\n• Gerenciar → Dispositivo para pareamento via QR"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• ⌘K でコマンドパレットを開く\n• ⌘⌥K でキャプチャしたフローをクリア\n• QR ペアリングは 管理 → デバイス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• ⌘K 打开命令面板\n• ⌘⌥K 清除已捕获的流量\n• 管理 → 设备 进行 QR 配对"
          }
        }
      }
    },
    "⌘-click to set as compare target": {
      "localizations": {
        "it": {
