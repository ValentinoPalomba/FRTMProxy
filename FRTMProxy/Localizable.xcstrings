            "value" : "Introduzca un argumento por línea. Los argumentos se pasan directamente sin shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez un argument par ligne. Les arguments sont transmis directement sans shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un argomento per riga. Gli argomenti vengono passati direttamente senza shell."
          }
        },
        "ja" : {
          "stringUnit" : {
