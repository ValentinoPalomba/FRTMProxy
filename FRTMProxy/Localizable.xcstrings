    "Use the same query syntax as flow search (e.g. `host:api.example.com status:>=400`, `method:POST`, `type:json`, `-type:image`).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la stessa sintassi di query della ricerca dei flussi (es. `host:api.example.com status:>=400`, `method:POST`, `type:json`, `-type:image`)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la misma sintaxis de consulta que la búsqueda de flujos (p. ej. `host:api.example.com status:>=400`, `method:POST`, `type:json`, `-type:image`)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la même syntaxe de requête que la recherche de flux (ex. `host:api.example.com status:>=400`, `method:POST`, `type:json`, `-type:image`)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Query-Syntax wie bei der Flow-Suche verwenden (z. B. `host:api.example.com status:>=400`, `method:POST`, `type:json`, `-type:image`)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a mesma sintaxe de query da busca de flows (ex.: `host:api.example.com status:>=400`, `method:POST`, `type:json`, `-type:image`)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フロー検索と同じクエリ構文を使用します (例: `host:api.example.com status:>=400`、`method:POST`、`type:json`、`-type:image`)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用与流量搜索相同的查询语法（例如 `host:api.example.com status:>=400`、`method:POST`、`type:json`、`-type:image`）。"
          }
        }
      }
    },
    "Used when FRTMProxy creates commits while publishing collections to a Git repository.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata quando FRTMProxy crea commit durante la pubblicazione delle collection in un repository Git."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando FRTMProxy crea commits al publicar colecciones en un repositorio Git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lorsque FRTMProxy crée des commits lors de la publication de collections vers un dépôt Git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn FRTMProxy beim Veröffentlichen von Sammlungen in ein Git-Repository Commits erstellt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
