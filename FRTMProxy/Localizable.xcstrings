    "Example: `main`, `v1.2.3`, or a commit SHA. The subdirectory limits the `.har` scan (e.g. `collections/`)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: `main`, `v1.2.3` oder ein Commit-SHA. Das Unterverzeichnis begrenzt den `.har`-Scan (z. B. `collections/`)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejemplo: `main`, `v1.2.3` o un SHA de commit. El subdirectorio limita el escaneo de `.har` (p. ej. `collections/`)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemple : `main`, `v1.2.3` ou un SHA de commit. Le sous-répertoire limite l'analyse `.har` (ex. `collections/`)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esempio: `main`, `v1.2.3` o uno SHA di commit. La sottocartella limita la scansione dei `.har` (es. `collections/`)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例: `main`、`v1.2.3`、またはコミット SHA。サブディレクトリは `.har` のスキャン範囲を限定します (例: `collections/`)。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemplo: `main`, `v1.2.3` ou um SHA de commit. O subdiretório limita a varredura de `.har` (ex.: `collections/`)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "示例：`main`、`v1.2.3` 或提交 SHA。子目录用于限定 `.har` 扫描范围（例如 `collections/`）。"
          }
        }
      }
    },
    "Example: set Response delay to 3000 to add 3 seconds to every response." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: Response-Verzögerung auf 3000 setzen, um jeder Response 3 Sekunden hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
